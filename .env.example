# Optional: if unset, the app uses heuristic (non-LLM) guidance.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: defaults to gpt-4.1-nano
OPENAI_MODEL=gpt-4.1-nano

# Optional: set to "production" in deployment to reduce debug verbosity.
APP_ENV=development

# Optional: expose debug metadata in API responses.
# In production this should normally stay "false".
EXPOSE_DEBUG_META=true

# Optional per-IP API rate limit (for POST /api/ask).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SEC=60
# Optional salt to avoid storing plain client IP identifiers in rate limiter table.
RATE_LIMIT_SALT=change-me-in-production

# Cloudflare Turnstile (recommended for anonymous public usage).
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
